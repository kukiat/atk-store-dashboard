# Copy this file to `.env` and fill in your real connection string.
# `.env` is gitignored — never commit real credentials.
DATABASE_URL=

# Optional: override the API port (defaults to 3004)
# PORT=

# Base URL of the external ATK store API — the users boot roster is fetched
ATK_STORE_API_URL=

# External IoT devices API — the shelfs layout is fetched live from
# {IOT_API_URL}/devices on EVERY read (no cache, no fallback: a failure 502s).
# MUST be https — the host 301s http → https and fetch drops `Authorization`
# across that redirect, so an http URL silently kills the bearer.
IOT_API_URL=
# Two accepted credentials, both sent on every request: IOT_ACCESS_TOKEN goes out as
# `Authorization: Bearer …`, IOT_API_KEY as `x-iot-api-key`.
IOT_API_KEY=
IOT_ACCESS_TOKEN=

# Demo escape hatch: force every shelf online regardless of what the IoT feed
# and the MQTT heartbeat say. The feed reports devices offline until their
# heartbeat lands, and an offline shelf never unlocks its doors (walkToShelf and
# scanQR 409), so the demo can't run without it. Leave unset in real use.
SHELFS_FORCE_ONLINE=

MQTT_URL=
MQTT_CONNECT_USE_TLS=
MQTT_USERNAME=
MQTT_PASSWORD=